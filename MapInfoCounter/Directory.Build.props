<?xml version="1.0" encoding="utf-8"?>
<!-- This file contains project properties used by the build. -->
<Project>

  <!-- Plugin Metadata -->
  <PropertyGroup>
    <PluginId>MapInfoCounter</PluginId>
    <PluginName>MapInfoCounter</PluginName>
    <Authors>zjavierf</Authors>
    <Version>1.1.0</Version>
    <GameVersion>1.40.8</GameVersion>
    <Description>Displays map info in-game.</Description>
    <!--<PluginIcon></PluginIcon>-->
    <!--<ProjectSource>https://github.com/zjavierf/MapInfoCounter</ProjectSource>-->
    <!--<ProjectHome>https://github.com/zjavierf/MapInfoCounter</ProjectHome>-->
    <!--<DonateUrl></DonateUrl>-->
  </PropertyGroup>

  <!-- Plugin Dependencies -->
  <ItemGroup>
    <DependsOn Include="BSIPA" Version="^4.3.0"/>
  </ItemGroup>
  
  <PropertyGroup>
    <BSMTProjectType>BSIPA</BSMTProjectType>
    <GenerateManifest>true</GenerateManifest>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <DisableZipRelease>true</DisableZipRelease>
  </PropertyGroup>
  
</Project>
